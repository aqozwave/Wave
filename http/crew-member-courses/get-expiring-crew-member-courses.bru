meta {
  name: Get expiring crew member courses
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/crew-member-courses?page=1&limit=25&status=attention
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Listado global de asignaciones (Vencimientos + Cursos de la tripulación).
  status: all | pending | valid | expired | expiring_soon | attention
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
