meta {
  name: Post accreditation
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/accreditations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organizationId": "{{contractorId}}",
    "message": "Favor subir el pack empresa (8 docs) para habilitación.",
    "dueAt": null
  }
}

docs {
  Solicitar documentación. Requiere contractorId (Post contractor o Get contractors).
  Módulo contractors on. 409 si ya hay HAB abierta.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const org = bru.getEnvVar("contractorId");
  if (!token || !org) {
    throw new Error("Definí accessToken y contractorId");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("accreditationId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.code: isDefined
  res.body.status: eq pending
}

settings {
  encodeUrl: true
  timeout: 0
}
