meta {
  name: Delete work notice
  type: http
  seq: 20
}

delete {
  url: {{baseUrl}}/api/v1/work-notices/{{workNoticeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft-delete del aviso (permiso work_notices.deactivate).
  Si tiene PT vinculado, también lo soft-deletea.
  Variable workNoticeId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
  if (!bru.getEnvVar("workNoticeId")) throw new Error("Sin workNoticeId.");
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
