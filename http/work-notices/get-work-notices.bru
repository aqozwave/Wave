meta {
  name: Get work notices
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/work-notices?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  AT1 — bandeja de avisos de trabajo.
  Requiere work_notices.read + módulo work_permits.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
