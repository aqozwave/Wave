meta {
  name: Post user unlock
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/users/{{userId}}/unlock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Limpia loginAttempts y lockUntil.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.loginAttempts: eq 0
}

settings {
  encodeUrl: true
  timeout: 0
}
