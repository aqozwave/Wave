meta {
  name: Delete user
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete. No permite borrarse a sí mismo.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
