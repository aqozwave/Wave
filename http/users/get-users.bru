meta {
  name: Get users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users?page=1&limit=20&includeInactive=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Requiere maestros.users:read. Admin solo su empresa.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
