meta {
  name: Delete travesia
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/travesias/{{travesiaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete. En S7 se rechazará si hay asignaciones activas.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("travesiaId");
  if (!token || !id) {
    throw new Error("Definí accessToken y travesiaId");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
  res.body.state: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
