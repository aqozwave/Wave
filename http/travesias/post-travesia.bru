meta {
  name: Post travesia
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/travesias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Travesía norte",
    "requiredPassages": 10,
    "businessId": "{{businessId}}"
  }
}

docs {
  Admin o superadmin. name y requiredPassages (10 o 4) obligatorios.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const businessId = bru.getEnvVar("businessId");
  if (!token || !businessId) {
    throw new Error("Definí accessToken y businessId en el entorno local");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("travesiaId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.requiredPassages: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
