meta {
  name: Patch document type
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/document-types/{{documentTypeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "tipo de prueba actualizado",
    "requiresExpiry": false,
    "crewCanView": false,
    "uploadBy": "hr",
    "viewBy": "prevention_admin_hr_assets"
  }
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("documentTypeId");
  if (!token || !id) {
    throw new Error("Definí accessToken y documentTypeId");
  }
}

assert {
  res.status: eq 200
  res.body.name: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
