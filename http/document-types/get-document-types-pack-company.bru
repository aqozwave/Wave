meta {
  name: Get document types pack company
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/document-types?page=1&limit=100&accreditationPack=company
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Filtra tipos con accreditationPack=company (pack empresa editable).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
