meta {
  name: Post forgot-password
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "fsoto@nachipa-w.com"
  }
}

docs {
  Público. Con Resend + dominio verificado usá un mail real (@nachipa-w.com).
  Copiá el token del mail (o del stub en log sin API key) a `resetPasswordToken` y corré Post reset-password.
}

assert {
  res.status: eq 200
  res.body.message: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
