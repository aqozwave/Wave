meta {
  name: Get me
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Sin login previo el literal "{{accessToken}}" llega a la API y responde 401.
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Elegí el entorno local y corré antes Post login (web)");
  }
}

assert {
  res.status: eq 200
  res.body.user.email: eq fsoto@nachipa-w.com
}

settings {
  encodeUrl: true
  timeout: 0
}
