meta {
  name: Get me
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Sin token el literal "{{accessToken}}" llega a la API y responde 401.
  // Con MFA: Login → pegar mfaCode → Post verify-mfa → recién ahí hay accessToken.
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error(
      "Sin accessToken. Con MFA: Post login (web) → mfaCode del mail → Post verify-mfa → Get me",
    );
  }
}

assert {
  res.status: eq 200
  res.body.user.email: eq fsoto@nachipa-w.com
}

settings {
  encodeUrl: true
  timeout: 0
}
