meta {
  name: Post reset-password
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{resetPasswordToken}}",
    "password": "Password2!"
  }
}

docs {
  Tras Post forgot-password, copiá el token del log/mail a `resetPasswordToken`.
}

script:pre-request {
  const token = bru.getEnvVar("resetPasswordToken");
  if (!token) {
    throw new Error(
      "Definí resetPasswordToken en el entorno local (token del log/mail tras forgot-password)",
    );
  }
}

assert {
  res.status: eq 200
  res.body.user.email: isDefined
  res.body.message: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
