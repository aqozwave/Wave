meta {
  name: Post login (ios)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: ios
}

body:json {
  {
    "email": "superadmin@nachipa.local",
    "password": "Password1!"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.refreshToken: isDefined
  res.body.user.email: eq superadmin@nachipa.local
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
    bru.setEnvVar("accessToken", body.accessToken);
    if (body.refreshToken) {
      bru.setVar("refreshToken", body.refreshToken);
      bru.setEnvVar("refreshToken", body.refreshToken);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
