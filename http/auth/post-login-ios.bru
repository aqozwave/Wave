meta {
  name: Post login (ios)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: ios
}

body:json {
  {
    "email": "superadmin@nachipa.local",
    "password": "Password1!"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.refreshToken: isDefined
  res.body.user.email: eq superadmin@nachipa.local
}

settings {
  encodeUrl: true
  timeout: 0
}
