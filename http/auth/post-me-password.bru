meta {
  name: Post me password
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/auth/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  X-Client: web
}

body:json {
  {
    "currentPassword": "TuClaveActual",
    "newPassword": "NuevaClave123"
  }
}

docs {
  Cambia la contraseña del usuario autenticado.
  Requiere X-Client. Web recibe refresh en cookie; body solo accessToken + user.
  Otras sesiones quedan inválidas (tokenVersion++).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

script:post-response {
  if (res.status === 200 && res.body.accessToken) {
    bru.setVar("accessToken", res.body.accessToken);
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.user.id: isString
}
