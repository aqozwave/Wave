meta {
  name: Post forgot-password unknown email
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "no-existe@nachipa.local"
  }
}

docs {
  Email inexistente: mismo 200 y mismo mensaje (anti-enumeración).
}

assert {
  res.status: eq 200
  res.body.message: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
