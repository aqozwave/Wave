meta {
  name: Post register unauthorized
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "intruso@nachipa.local",
    "password": "Password1!",
    "username": "intruso",
    "firstName": "Sin",
    "lastName": "Permiso",
    "run": "33.333.333-3"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq unauthorized
}

settings {
  encodeUrl: true
  timeout: 0
}
