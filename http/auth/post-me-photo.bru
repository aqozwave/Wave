meta {
  name: Post me photo
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/auth/me/photo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fileName": "avatar.png",
    "mimeType": "image/png",
    "contentBase64": "{{photoBase64}}"
  }
}

docs {
  Sube o reemplaza la foto del usuario autenticado (JPEG/PNG/WebP, máx 2 MB).
  Completar photoBase64.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.user.photoProfile: isString
}
