meta {
  name: Post login (web)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: web
}

body:json {
  {
    "email": "superadmin@nachipa.local",
    "password": "Password1!"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.user.email: eq superadmin@nachipa.local
}

script:post-response {
  if (res.status === 200 && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
