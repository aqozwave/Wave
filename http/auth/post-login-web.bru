meta {
  name: Post login (web)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: web
}

body:json {
  {
    "email": "fsoto@nachipa-w.com",
    "password": "Password1!"
  }
}

docs {
  Con LOGIN_MFA_ENABLED=true responde mfaRequired + challengeId (sin accessToken).
  Copiá challengeId a mfaChallengeId, el código del mail a mfaCode, y corré Post verify-mfa.
  Con MFA=false responde accessToken como antes.
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body) return;
  if (body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
    bru.setEnvVar("accessToken", body.accessToken);
  }
  if (body.mfaRequired && body.challengeId) {
    bru.setEnvVar("mfaChallengeId", body.challengeId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
