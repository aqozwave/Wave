meta {
  name: Post login (web)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: web
}

body:json {
  {
    "email": "superadmin@nachipa.local",
    "password": "Password1!"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.user.email: eq superadmin@nachipa.local
}

script:post-response {
  // Guarda el Bearer para Get me y el resto de rutas protegidas.
  // setVar = colección (siempre); setEnvVar = entorno local (si está activo).
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
    bru.setEnvVar("accessToken", body.accessToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
