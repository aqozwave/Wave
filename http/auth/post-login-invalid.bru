meta {
  name: Post login invalid password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: web
}

body:json {
  {
    "email": "fsoto@nachipa-w.com",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq invalid_credentials
}

settings {
  encodeUrl: true
  timeout: 0
}
