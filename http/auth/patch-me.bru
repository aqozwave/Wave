meta {
  name: Patch me
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v1/auth/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "firstName": "Francisco",
    "lastName": "Soto"
  }
}

docs {
  Actualiza nombre/apellido/correo del usuario autenticado.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.user.id: isString
}
