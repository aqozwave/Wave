meta {
  name: Post reset-password invalid
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "token-invalido-para-probar-400",
    "password": "Password2!"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq invalid_reset_token
}

settings {
  encodeUrl: true
  timeout: 0
}
