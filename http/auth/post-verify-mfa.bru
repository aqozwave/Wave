meta {
  name: Post verify-mfa
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-mfa
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: web
}

body:json {
  {
    "challengeId": "{{mfaChallengeId}}",
    "code": "{{mfaCode}}"
  }
}

docs {
  Orden obligatorio:
  1) Post login (web) → llena mfaChallengeId (sin accessToken).
  2) Environments → local → pegá el código del mail en mfaCode → Save.
  3) Corré ESTE request (Post verify-mfa). El script guarda accessToken.
  4) Recién ahí Get me.
  Pegar mfaCode solo NO llena accessToken. No commitear códigos.
}

script:pre-request {
  // Leemos del entorno activo (evita {{mfaCode}} literal si no interpola).
  const challengeId = bru.getEnvVar("mfaChallengeId");
  const code = String(bru.getEnvVar("mfaCode") ?? "").trim();
  if (!challengeId || !code) {
    throw new Error(
      "Save el entorno local con mfaChallengeId + mfaCode, y corré este Post verify-mfa (no Get me)",
    );
  }
  req.setBody(
    JSON.stringify({
      challengeId,
      code,
    }),
  );
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body) return;
  if (body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
    bru.setEnvVar("accessToken", body.accessToken);
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.user.email: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
