meta {
  name: Delete me photo
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/api/v1/auth/me/photo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Quita la foto del usuario autenticado.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.user.photoProfile: isNull
}
