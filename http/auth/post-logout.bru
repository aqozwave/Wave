meta {
  name: Post logout
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Elegí el entorno local y corré antes Post login (web)");
  }
}

script:post-response {
  // Tras logout el access viejo ya no vale; limpiamos la var de Bruno.
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", "");
    bru.setEnvVar("accessToken", "");
  }
}

assert {
  res.status: eq 200
  res.body.ok: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
