meta {
  name: Post register
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nuevo@nachipa.local",
    "password": "Password1!",
    "username": "nuevo.user",
    "firstName": "Nuevo",
    "lastName": "Usuario",
    "run": "12.345.678-9"
  }
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Corré antes Post login (web) como superadmin");
  }
}

docs {
  Tras 201, la API loguea el confirm token (stub hasta Resend).
  Copiálo a `confirmEmailToken` del entorno local y corré Post confirm-email.
}

assert {
  res.status: eq 201
  res.body.user.confirmed: eq false
  res.body.user.email: eq nuevo@nachipa.local
  res.body.message: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
