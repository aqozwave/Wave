meta {
  name: Post register duplicate email
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "superadmin@nachipa.local",
    "password": "Password1!",
    "username": "otro.user",
    "firstName": "Otro",
    "lastName": "Usuario",
    "run": "98.765.432-1"
  }
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Corré antes Post login (web) como superadmin");
  }
}

assert {
  res.status: eq 409
  res.body.code: eq duplicate_email
}

settings {
  encodeUrl: true
  timeout: 0
}
