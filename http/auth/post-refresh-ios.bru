meta {
  name: Post refresh (ios)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client: ios
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:pre-request {
  const token = bru.getVar("refreshToken") || bru.getEnvVar("refreshToken");
  if (!token) {
    throw new Error("Corré antes Post login (ios) para guardar refreshToken");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body) {
    if (body.accessToken) {
      bru.setVar("accessToken", body.accessToken);
      bru.setEnvVar("accessToken", body.accessToken);
    }
    if (body.refreshToken) {
      bru.setVar("refreshToken", body.refreshToken);
      bru.setEnvVar("refreshToken", body.refreshToken);
    }
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
  res.body.refreshToken: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
