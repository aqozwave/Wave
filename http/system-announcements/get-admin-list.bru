meta {
  name: Get admin list
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/system-announcements/admin?includeExpired=true&limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Listado admin (superadmin). includeExpired / includeDeleted opcionales.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
