meta {
  name: Get activity logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/activity-logs?page=1&limit=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Listado de auditoría (solo superadmin).
  Query: action, resource, success=true|false, page, limit.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
