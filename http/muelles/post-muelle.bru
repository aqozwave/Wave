meta {
  name: Post muelle
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/muelles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Muelle norte",
    "portName": "Puerto Montt",
    "businessId": "{{businessId}}"
  }
}

docs {
  Admin o superadmin. name y portName obligatorios.
  Puertos conocidos del portal viejo: Chacabuco, Calbuco, Quellón, Puerto Montt (texto libre).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const businessId = bru.getEnvVar("businessId");
  if (!token || !businessId) {
    throw new Error("Definí accessToken y businessId en el entorno local");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("muelleId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.portName: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
