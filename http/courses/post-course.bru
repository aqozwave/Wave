meta {
  name: Post course
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "STCW básico",
    "whereTaught": "Armada de Chile",
    "businessId": "{{businessId}}",
    "isMandatory": true
  }
}

docs {
  Admin o superadmin. name y whereTaught obligatorios.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const businessId = bru.getEnvVar("businessId");
  if (!token || !businessId) {
    throw new Error("Definí accessToken y businessId en el entorno local");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("courseId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.whereTaught: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
