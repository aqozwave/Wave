meta {
  name: Delete crew member travesia
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/travesias/{{assignmentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
