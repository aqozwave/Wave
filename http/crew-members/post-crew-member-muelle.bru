meta {
  name: Post crew member muelle
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/muelles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "muelleId": "{{muelleId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
