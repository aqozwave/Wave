meta {
  name: Get crew member
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Ficha por id. Variable crewMemberId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
