meta {
  name: Get crew member documents
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/documents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Lista documentos no borrados del tripulante.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
