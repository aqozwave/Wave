meta {
  name: Post crew member document
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/documents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "documentTypeId": "{{documentTypeId}}",
    "fileName": "amonestacion.pdf",
    "mimeType": "application/pdf",
    "contentBase64": "",
    "sourceModule": "crew"
  }
}

docs {
  Sube PDF mínimo en base64. Corré Get document types antes (setea documentTypeId, preferencia WL).
  Variables: crewMemberId, documentTypeId.
  Enforcement: uploadBy del tipo debe incluir al actor (403 document_upload_forbidden).
  appliesTo=external → 400 document_type_not_for_crew.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const crewMemberId = bru.getEnvVar("crewMemberId");
  const documentTypeId = bru.getEnvVar("documentTypeId");
  if (!token) throw new Error("Sin accessToken");
  if (!crewMemberId) throw new Error("Sin crewMemberId");
  if (!documentTypeId) throw new Error("Sin documentTypeId — corré Get document types");
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("crewDocumentId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.documentTypeId: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
