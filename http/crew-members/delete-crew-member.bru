meta {
  name: Delete crew member
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete. Desvincula userId.
  Si el usuario vinculado es User/Colaborador, lo desactiva (state=false + invalida tokens); no lo borra.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
