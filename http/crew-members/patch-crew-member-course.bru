meta {
  name: Patch crew member course
  type: http
  seq: 22
}

patch {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/courses/{{crewCourseAssignmentId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "completedAt": "2026-01-15T12:00:00.000Z",
    "expiresAt": "2027-01-15T12:00:00.000Z"
  }
}

docs {
  Actualiza fechas; status se recalcula. Variables: crewMemberId, crewCourseAssignmentId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const crewMemberId = bru.getEnvVar("crewMemberId");
  const assignmentId = bru.getEnvVar("crewCourseAssignmentId");
  if (!token) throw new Error("Sin accessToken");
  if (!crewMemberId) throw new Error("Sin crewMemberId");
  if (!assignmentId) throw new Error("Sin crewCourseAssignmentId");
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
