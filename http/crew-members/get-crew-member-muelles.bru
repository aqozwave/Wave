meta {
  name: Get crew member muelles
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/muelles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
