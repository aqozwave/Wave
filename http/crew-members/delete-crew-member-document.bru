meta {
  name: Delete crew member document
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/documents/{{documentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete + borra archivo de disco.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
