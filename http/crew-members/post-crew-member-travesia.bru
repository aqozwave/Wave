meta {
  name: Post crew member travesia
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/crew-members/{{crewMemberId}}/travesias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "travesiaId": "{{travesiaId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
