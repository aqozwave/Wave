meta {
  name: Post contractor
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/contractors
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Soldaduras del Sur SpA",
    "rut": "76.123.456-0",
    "role": "occasional",
    "specialty": "Soldadura estructural",
    "contactName": "Ana Pérez",
    "contactEmail": "ana@ejemplo.cl",
    "contactPhone": "+56 9 1234 5678",
    "businessId": "{{businessId}}"
  }
}

docs {
  Alta org contratista. Admin: businessId se ignora (usa su empresa).
  Superadmin: businessId obligatorio. RUT con DV válido.
  Ajustá el RUT si ya existe (409).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

script:post-response {
  const body = res.getBody();
  if ((res.getStatus() === 201 || res.getStatus() === 200) && body && body.id) {
    bru.setEnvVar("contractorId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.rut: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
