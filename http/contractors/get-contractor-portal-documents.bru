meta {
  name: Get contractor portal documents
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/api/v1/contractors/me/accreditation/documents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  E4 checklist pack company de la HAB del portal.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
}

assert {
  res.status: in [200, 403, 404]
}

settings {
  encodeUrl: true
  timeout: 0
}
