meta {
  name: Post contractor user faena (invite)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "faena.contratista@ejemplo.cl",
    "firstName": "Pedro",
    "lastName": "Faena",
    "run": "22.222.222-2",
    "roleKey": "contratista_faena"
  }
}

docs {
  Invita trabajador faena: ve PT de su org + pedir cierre.
  Sin HAB ni personal. Ajustá email/RUN si ya existen (409).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
  const id = bru.getEnvVar("contractorId");
  if (!id) {
    throw new Error("Sin contractorId. Corré Post contractor antes.");
  }
}

script:post-response {
  const body = res.getBody();
  if ((res.getStatus() === 201 || res.getStatus() === 200) && body && body.id) {
    bru.setEnvVar("contractorFaenaUserId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.internalRol: eq contratista_faena
  res.body.invitePending: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}
