meta {
  name: Delete contractor
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete (deletedAt + active=false). No correr en demos con datos que quieras conservar.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("contractorId");
  if (!token || !id) {
    throw new Error("Definí accessToken y contractorId");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
