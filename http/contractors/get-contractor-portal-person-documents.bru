meta {
  name: Get contractor portal person documents
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/contractors/me/accreditation/people/{{portalPersonId}}/documents
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  E5 checklist pack person de una persona en la HAB del portal.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
  const personId = bru.getEnvVar("portalPersonId");
  if (!personId) throw new Error("Sin portalPersonId. Corré Post contractor portal person.");
}

assert {
  res.status: in [200, 403, 404]
}

settings {
  encodeUrl: true
  timeout: 0
}
