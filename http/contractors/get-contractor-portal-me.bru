meta {
  name: Get contractor portal me
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/v1/contractors/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  E19 org del portal (antecedentes).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
}

assert {
  res.status: in [200, 403]
}

settings {
  encodeUrl: true
  timeout: 0
}
