meta {
  name: Get contractor
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Detalle de organización contratista por id.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("contractorId");
  if (!token || !id) {
    throw new Error("Definí accessToken y contractorId");
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
