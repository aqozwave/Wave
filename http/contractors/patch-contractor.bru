meta {
  name: Patch contractor
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "specialty": "Soldadura y corte",
    "role": "permanent"
  }
}

docs {
  Editar ficha (admin/superadmin + contractors.update).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("contractorId");
  if (!token || !id) {
    throw new Error("Definí accessToken y contractorId");
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
