meta {
  name: Get contractor people
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}/people?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  P2 — personal externo de la org.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
  const id = bru.getEnvVar("contractorId");
  if (!id) {
    throw new Error("Sin contractorId. Corré Post contractor antes.");
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
