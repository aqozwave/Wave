meta {
  name: Delete contractor person
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/api/v1/contractors/{{contractorId}}/people/{{contractorPersonId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete de persona (deletedAt + active=false).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
  if (!bru.getEnvVar("contractorId") || !bru.getEnvVar("contractorPersonId")) {
    throw new Error("Faltan contractorId / contractorPersonId.");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
