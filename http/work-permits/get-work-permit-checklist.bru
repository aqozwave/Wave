meta {
  name: Get work permit checklist
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/work-permits/{{workPermitId}}/checklist?stage=contractor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Lista ítems activos del tipo + respuestas contractor.
  Guarda el primer checklistItemId sin respuesta en env si hace falta.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
  if (!bru.getEnvVar("workPermitId")) throw new Error("Sin workPermitId.");
}

script:post-response {
  const items = res.body.items || [];
  const first = items[0];
  if (first && first.checklistItemId) {
    bru.setEnvVar("checklistItemId", first.checklistItemId);
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
