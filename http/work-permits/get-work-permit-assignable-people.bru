meta {
  name: Get work permit assignable-people
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/work-permits/{{workPermitId}}/assignable-people
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Personal activo de la org con readiness: pack persona + exigencias document/person del tipo.
  canAssign=false si falta pack o docs de faena (ej. BUC Ruido).
  Variable workPermitId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken.");
  if (!bru.getEnvVar("workPermitId")) throw new Error("Sin workPermitId.");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.personRequirementLabels: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
