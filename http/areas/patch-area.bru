meta {
  name: Patch area
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/areas/{{areaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Cubierta superior"
  }
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("areaId");
  if (!token || !id) {
    throw new Error("Definí accessToken y areaId");
  }
}

assert {
  res.status: eq 200
  res.body.name: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
