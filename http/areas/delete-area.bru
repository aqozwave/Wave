meta {
  name: Delete area
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/areas/{{areaId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete. 409 si hay usuarios activos con ese areaId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("areaId");
  if (!token || !id) {
    throw new Error("Definí accessToken y areaId");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
  res.body.state: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
