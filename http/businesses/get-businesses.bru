meta {
  name: Get businesses
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/businesses?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Requiere accessToken (login → MFA → verify-mfa).
  Superadmin: todas las empresas no borradas.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error(
      "Sin accessToken. Corré login + verify-mfa antes (entorno local).",
    );
  }
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: isDefined
  res.body.page: eq 1
}

settings {
  encodeUrl: true
  timeout: 0
}
