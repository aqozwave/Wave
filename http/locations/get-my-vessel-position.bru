meta {
  name: Get my vessel position
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/locations/me/position
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Última posición de la nave del usuario. 200 con objeto o null si aún no hay lecturas.
  400 si el usuario no tiene locationId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
