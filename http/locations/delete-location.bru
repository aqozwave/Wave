meta {
  name: Delete location
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/locations/{{locationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete (admin o superadmin). 409 si hay usuarios activos con ese locationId.
  Tras 200, Get location → 404 y no aparece en el listado.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("locationId");
  if (!token || !id) {
    throw new Error("Definí accessToken y locationId en el entorno local");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
  res.body.state: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
