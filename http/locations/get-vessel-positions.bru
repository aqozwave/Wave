meta {
  name: Get vessel positions (fleet)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/locations/positions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Última señal por nave (tenant). Admin: mapa flota + tabla. Superadmin puede pasar ?businessId=.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
