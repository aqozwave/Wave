meta {
  name: Get location vessel position
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/locations/{{locationId}}/position
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Última posición de una ubicación por id (tenant). Definí locationId en el entorno.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("locationId");
  if (!token || !id) {
    throw new Error("Definí accessToken y locationId en el entorno local");
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}
