meta {
  name: Post training session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/training-sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "trainingId": "{{trainingId}}",
    "locationId": "{{locationId}}",
    "heldAt": "2026-11-11T15:00:00.000Z",
    "notes": "Sesión de prueba",
    "crewMemberIds": ["{{crewMemberId}}"]
  }
}

docs {
  Crea borrador (1 id = individual; varios = grupal). Permiso training_sessions.create.
  Definí trainingId, locationId (nave) y crewMemberId (o ampliá el array).
  No cierra la sesión: el cierre es POST …/complete con acta.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq draft
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("trainingSessionId", res.body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
