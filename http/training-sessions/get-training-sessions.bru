meta {
  name: Get training sessions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/training-sessions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Listado paginado de sesiones. Filtros opcionales: status, trainingId, businessId.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
