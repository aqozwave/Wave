meta {
  name: Get training session
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/training-sessions/{{trainingSessionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Detalle de sesión con asistentes.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("trainingSessionId");
  if (!token || !id) throw new Error("Definí accessToken y trainingSessionId");
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
