meta {
  name: Post checklist item
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/permit-types/{{permitTypeId}}/checklist-items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "text": "Ítem de prueba Bruno"
  }
}

docs {
  Sin order → se asigna al final (max+1).
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("permitTypeId");
  if (!token || !id) {
    throw new Error("Definí accessToken y permitTypeId");
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 201 && body && body.id) {
    bru.setEnvVar("checklistItemId", body.id);
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
