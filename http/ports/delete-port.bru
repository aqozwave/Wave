meta {
  name: Delete port
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/ports/{{portId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Soft delete. 409 si hay muelles activos en el puerto.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  const id = bru.getEnvVar("portId");
  if (!token || !id) {
    throw new Error("Definí accessToken y portId");
  }
}

assert {
  res.status: eq 200
  res.body.deletedAt: isDefined
  res.body.state: eq false
}

settings {
  encodeUrl: true
  timeout: 0
}
