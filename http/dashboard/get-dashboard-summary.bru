meta {
  name: Get dashboard summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/dashboard/summary?upcomingLimit=10&vesselChartLimit=5&courseChartLimit=5&vesselListLimit=8
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  KPIs del Panel + próximos vencimientos + breakdowns por nave/curso + lista de naves
  + monthlyCompliance (12 meses; null si aún no hay snapshot).
  soft = 31–60 d, solid = 0–30 d. Permiso: dashboard read.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) {
    throw new Error("Sin accessToken. Corré login + verify-mfa antes.");
  }
}

assert {
  res.status: eq 200
  res.body.kpis: isDefined
  res.body.upcoming: isDefined
  res.body.byVessel: isDefined
  res.body.byCourse: isDefined
  res.body.vessels: isDefined
  res.body.monthlyCompliance: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
