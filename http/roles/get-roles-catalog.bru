meta {
  name: Get roles catalog
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/roles/catalog
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Solo superadmin. Matriz de permisos para la UI.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.catalog: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
