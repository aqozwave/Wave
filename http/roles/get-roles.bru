meta {
  name: Get roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/roles?includeInactive=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Admin o superadmin.
}

script:pre-request {
  const token = bru.getVar("accessToken") || bru.getEnvVar("accessToken");
  if (!token) throw new Error("Sin accessToken");
}

assert {
  res.status: eq 200
  res.body.items: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
