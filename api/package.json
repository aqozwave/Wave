{
  "name": "@wave/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "etl:business": "tsx --env-file=.env etl/business.ts",
    "etl:location": "tsx --env-file=.env etl/location.ts",
    "etl:area": "tsx --env-file=.env etl/area.ts"
  },
  "prisma": {
