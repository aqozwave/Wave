// Convenciones: IDs uuid; deletedAt en User y Role; tablas snake_case plural con @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleDataScope {
  all
  business
  location
  area
  self
}

/// Propósito del token de correo (confirmación de cuenta o reset de clave).
enum EmailTokenPurpose {
  confirm_email
  reset_password
}

model Role {
  id            String        @id @default(uuid()) @db.Uuid
  legacyMongoId String?       @unique @map("legacy_mongo_id")
  key           String
  name          String
  description   String        @default("")
  isSystem      Boolean       @default(false) @map("is_system")
  dataScope     RoleDataScope @map("data_scope")
  /// [{ resource, actions: string[] }] — mismo shape que el portal viejo.
  permissions   Json          @default("[]")
  state         Boolean       @default(true)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]

  @@unique([key])
  @@map("roles")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  run           String
  username      String
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String
  pendingEmail  String?   @map("pending_email")
  internalRol   String    @default("user") @map("internal_rol")
  roleId        String?   @map("role_id") @db.Uuid
  role          Role?     @relation(fields: [roleId], references: [id])
  state         Boolean   @default(true)
  confirmed     Boolean   @default(false)
  // Tenant: FK a businesses (Sección 2). location/area cuando existan (S3–S4).
  businessId    String?   @map("business_id") @db.Uuid
  business      Business? @relation(fields: [businessId], references: [id])
  locationId    String?   @map("location_id") @db.Uuid
  areaId        String?   @map("area_id") @db.Uuid
  tokenVersion  Int       @default(0) @map("token_version")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp   String?   @map("last_login_ip")
  loginAttempts Int       @default(0) @map("login_attempts")
  lockUntil     DateTime? @map("lock_until") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  emailTokens     EmailToken[]
  loginChallenges LoginChallenge[]

  @@index([email])
  @@index([username])
  @@index([businessId])
  @@map("users")
}

/// Empresa (tenant). Soft delete; nombre único entre no borradas (índice parcial en migración).
model Business {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  rut           String?
  name          String
  giro          String?
  country       String?   @default("Chile")
  commune       String?
  city          String?
  phone         String?
  email         String?
  description   String?
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]

  @@index([name])
  @@map("businesses")
}

/// Challenge MFA de login: código de 6 dígitos por correo (hash en BD).
model LoginChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  /// UUID público que recibe el cliente (verify / resend).
  challengeId String   @unique @map("challenge_id")
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  /// SHA-256 hex del código en claro.
  codeHash    String   @map("code_hash")
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Tokens de un solo uso enviados por correo (hash en BD; plain solo en el mail).
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  purpose   EmailTokenPurpose
  /// SHA-256 hex del token en claro.
  tokenHash String            @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([tokenHash])
  @@index([userId, purpose])
  @@map("email_tokens")
}
