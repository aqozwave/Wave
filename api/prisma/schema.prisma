// Convenciones: IDs uuid; deletedAt en User y Role; tablas snake_case plural con @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleDataScope {
  all
  business
  location
  area
  self
}

/**
 * Submódulos de Prevención por empresa (P0 · S6).
 * Apagar `contractors` debe apagar también `work_permits` (R-02; se aplica en service).
 * PPE / near_misses etc. se agregan al enum cuando existan pantallas.
 */
enum BusinessModuleKey {
  contractors
  work_permits
  trainings
}

/**
 * Criticidad del tipo de permiso (P1 · P14/P15).
 * UI: chips Activo + Criticidad alta/media/baja.
 */
enum PermitCriticality {
  low
  medium
  high
}

/**
 * Cómo se entrega el AST cuando requiresAst=true.
 * Solo BUC en el seed inicial; FORM = formulario, PDF = archivo, BOTH = ambos.
 */
enum PermitAstMode {
  form
  pdf
  both
}

/**
 * Tipo de exigencia del permiso (P1 · P15 Exigencias).
 * document = tipo de doc o pack de habilitación; training = curso; checklist = lista del tipo.
 */
enum PermitRequirementKind {
  document
  training
  checklist
}

/**
 * A quién aplica la exigencia.
 * company = empresa contratista; person = cada trabajador; permit = el PT en sí.
 */
enum PermitRequirementScope {
  company
  person
  permit
}

/**
 * Momento del ciclo en que se exige.
 * before = antes de iniciar; closure = al cierre.
 */
enum PermitRequirementMoment {
  before
  closure
}

/**
 * Pack de documentos de habilitación («los 8»).
 * company = 8 de empresa; person = 8 por persona.
 */
enum AccreditationScope {
  company
  person
}

/// Propósito del token de correo (confirmación de cuenta o reset de clave).
enum EmailTokenPurpose {
  confirm_email
  reset_password
}

/// Tipo de lugar de trabajo. Nullable: ETL deja null; se clasifica después en Wave.
/// UI: vessel=Nave, office=Oficina, warehouse=Bodega, other=Otro.
enum LocationKind {
  vessel
  office
  warehouse
  other
}

/// Oficial de nave asociado a un certificado de competencia (portal viejo).
/// UI: captain=Capitán, first_pilot=Primer piloto. Null = sin clasificar.
enum OfficerKind {
  captain
  first_pilot
}

/**
 * Estado de una asignación de curso al tripulante (portal viejo CREW_COURSE_STATUS).
 * Se recalcula con expiresAt + DAYS_TO_NOTIFY; pending si no hay completedAt.
 */
enum CrewCourseStatus {
  pending
  valid
  expiring_soon
  expired
}

/**
 * Origen de la asignación (portal viejo CREW_COURSE_SOURCE).
 * rank = legacy (ya no se auto-crea); certificate = por título; manual = a mano.
 */
enum CrewCourseSource {
  rank
  certificate
  manual
}

/**
 * Tipo de aviso en el outbox (portal viejo OUTBOX_TYPE).
 * Libreta y digests quedan modelados; el generador de S9 empieza por cursos.
 */
enum NotificationOutboxType {
  boarding_book_expiring
  course_expiring
  course_expired
  boarding_book_admin_digest
  course_admin_digest
}

/**
 * Estado del envío en el outbox (portal viejo OUTBOX_STATUS).
 * El worker: pending → processing → sent | failed; cancelado a mano o por dedupe.
 */
enum NotificationOutboxStatus {
  pending
  processing
  sent
  failed
  cancelled
}

/**
 * Tipo de aviso de sistema (portal viejo SYSTEM_ANNOUNCEMENT_KIND).
 */
enum SystemAnnouncementKind {
  version
  maintenance
  config
}

/**
 * Acción de auditoría (portal viejo ACTIVITY_ACTION).
 * LOGIN/LOGOUT/REGISTER = auth; CREATE/UPDATE/DELETE = CRUD de dominio.
 */
enum ActivityAction {
  LOGIN
  LOGOUT
  REGISTER
  CREATE
  UPDATE
  DELETE
}

/**
 * Recurso auditado (portal viejo ACTIVITY_RESOURCE).
 * Se amplía cuando un módulo empieza a llamar a recordActivity.
 */
enum ActivityResource {
  auth
  user
  business
  location
  crewMember
  crewMemberCourse
  area
  rank
  academicDegree
  competencyCertificate
  documentType
  muelle
  travesia
  port
  course
  role
  /// Catálogo tipos de permiso (Prevención / P14m).
  permitType
  /// Catálogo capacitaciones Prevención (P1).
  training
  system
}

/**
 * Puerto del catálogo por empresa (maestro de muelles).
 * Nombre único por business entre no borrados (índice parcial en migración).
 */
model Port {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  /// Nombre del puerto; casing se conserva (ej. "Puerto Montt").
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  muelles       Muelle[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("ports")
}

/**
 * Muelle por puerto y empresa.
 * Único por (portId, name, business) entre no borrados (índice parcial).
 * El service valida que port.businessId === muelle.businessId.
 */
model Muelle {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  portId        String    @map("port_id") @db.Uuid
  port          Port      @relation(fields: [portId], references: [id])
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewAssignments CrewMemberMuelle[]

  @@index([businessId])
  @@index([portId])
  @@index([name, portId, businessId])
  @@map("muelles")
}

/**
 * Travesía del catálogo por empresa (cuota de pasadas para oficiales).
 * requiredPassages solo 10 o 4 (validado en Zod; Int en PG).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model Travesia {
  id               String    @id @default(uuid()) @db.Uuid
  legacyMongoId    String?   @unique @map("legacy_mongo_id")
  name             String
  /// Cuota de pasadas requeridas (10 o 4 en el portal viejo).
  requiredPassages Int       @map("required_passages")
  businessId       String    @map("business_id") @db.Uuid
  business         Business  @relation(fields: [businessId], references: [id])
  state            Boolean   @default(true)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewAssignments  CrewMemberTravesia[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("travesias")
}

model Role {
  id            String        @id @default(uuid()) @db.Uuid
  legacyMongoId String?       @unique @map("legacy_mongo_id")
  key           String
  name          String
  description   String        @default("")
  isSystem      Boolean       @default(false) @map("is_system")
  dataScope     RoleDataScope @map("data_scope")
  /// [{ resource, actions: string[] }] — mismo shape que el portal viejo.
  permissions   Json          @default("[]")
  state         Boolean       @default(true)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]

  @@unique([key])
  @@map("roles")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  legacyMongoId   String?          @unique @map("legacy_mongo_id")
  run             String
  username        String
  passwordHash    String           @map("password_hash")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  email           String
  pendingEmail    String?          @map("pending_email")
  /// Ruta relativa de foto (/uploads/…), como photoProfile del portal viejo.
  photoProfile    String?          @map("photo_profile")
  internalRol     String           @default("user") @map("internal_rol")
  roleId          String?          @map("role_id") @db.Uuid
  role            Role?            @relation(fields: [roleId], references: [id])
  state           Boolean          @default(true)
  confirmed       Boolean          @default(false)
  // Tenant: business (S2), location (S3); area cuando exista (S4).
  businessId      String?          @map("business_id") @db.Uuid
  business        Business?        @relation(fields: [businessId], references: [id])
  locationId      String?          @map("location_id") @db.Uuid
  location        Location?        @relation(fields: [locationId], references: [id])
  areaId          String?          @map("area_id") @db.Uuid
  area            Area?            @relation(fields: [areaId], references: [id])
  tokenVersion    Int              @default(0) @map("token_version")
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz
  lastLoginIp     String?          @map("last_login_ip")
  loginAttempts   Int              @default(0) @map("login_attempts")
  lockUntil       DateTime?        @map("lock_until") @db.Timestamptz
  /// Acceso con vencimiento (útiles para externos / invitados temporales).
  accessExpiresAt DateTime?        @map("access_expires_at") @db.Timestamptz
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  emailTokens     EmailToken[]
  loginChallenges LoginChallenge[]
  /// Refresh rotativos (hash); permite revocar uno sin invalidar todos.
  refreshTokens   RefreshToken[]
  /// Tripulante vinculado (FK en crew_members.user_id; 1:1).
  crewMember      CrewMember?
  /// Documentos de tripulante subidos por este usuario.
  uploadedCrewDocuments CrewMemberDocument[]
  /// Filas de auditoría donde este usuario es el actor.
  activityLogs ActivityLog[]
  /// Avisos de sistema marcados como leídos.
  announcementReads UserAnnouncementRead[]
  /// Avisos publicados por este usuario (si aplica).
  announcementsCreated SystemAnnouncement[] @relation("AnnouncementCreatedBy")
  /// Activaciones/desactivaciones de submódulos Prevención hechas por este usuario.
  businessModulesEnabled BusinessModule[] @relation("BusinessModuleEnabledBy")

  @@index([email])
  @@index([username])
  @@index([businessId])
  @@index([locationId])
  @@index([areaId])
  @@map("users")
}

/// Refresh JWT rotativo: solo se guarda el hash SHA-256 (revocable).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex del JWT de refresh (nunca el token en claro).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

/// Empresa (tenant). Soft delete; nombre único entre no borradas (índice parcial en migración).
model Business {
  id                     String                  @id @default(uuid()) @db.Uuid
  legacyMongoId          String?                 @unique @map("legacy_mongo_id")
  rut                    String?
  name                   String
  giro                   String?
  country                String?                 @default("Chile")
  commune                String?
  city                   String?
  phone                  String?
  email                  String?
  description            String?
  state                  Boolean                 @default(true)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  users                  User[]
  locations              Location[]
  areas                  Area[]
  ranks                  Rank[]
  academicDegrees        AcademicDegree[]
  competencyCertificates CompetencyCertificate[]
  courses                Course[]
  ports                  Port[]
  muelles                Muelle[]
  travesias              Travesia[]
  crewMembers            CrewMember[]
  documentTypes          DocumentType[]
  /// Filas del outbox de notificaciones de esta empresa.
  notificationOutbox     NotificationOutbox[]
  /// Interruptores de Prevención (contractors / work_permits / trainings).
  modules                BusinessModule[]
  /// Catálogo de tipos de permiso de trabajo (ALT, CAL, …).
  permitTypes            PermitType[]
  /// Catálogo de capacitaciones de Prevención (EXT-01, ODI-01, …).
  trainings              Training[]

  @@index([name])
  @@map("businesses")
}

/**
 * Interruptor de un submódulo de Prevención para un tenant.
 * Nace en Wave (sin legacyMongoId). Una fila por (empresa, key); default enabled=false.
 */
model BusinessModule {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Clave del submódulo (contractors | work_permits | trainings).
  key         BusinessModuleKey
  /// Si false, los permisos de ese módulo no cuentan (capa 1 de autorización).
  enabled     Boolean           @default(false)
  /// Cuándo se prendió por última vez (null si nunca o quedó apagado).
  enabledAt   DateTime?         @map("enabled_at") @db.Timestamptz
  /// Superadmin (u operador) que hizo el último cambio a enabled=true; null si se apagó o seed.
  enabledById String?           @map("enabled_by_id") @db.Uuid
  enabledBy   User?             @relation("BusinessModuleEnabledBy", fields: [enabledById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([businessId, key])
  @@index([businessId])
  @@map("business_modules")
}

/**
 * Tipo de documento del expediente (maestro por empresa).
 * Códigos alineados al sistema HR (CO, EN, VI, TI…).
 * Unique (code, business) entre no borrados: índice parcial en migración.
 */
model DocumentType {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  /// Código corto estable (ej. CO, EN, VI) — 2 a 4 letras.
  code          String
  name          String
  /// general | finiquito | requerimiento | prevencion | maritimo | activo
  subtype       String    @default("general")
  /// crew | external | crew_and_external (Figma «Aplica a»).
  appliesTo     String    @default("crew_and_external") @map("applies_to")
  /// Si true, al cargar pide fecha de vencimiento (Figma «Vence»).
  requiresExpiry Boolean  @default(false) @map("requires_expiry")
  /// Quién puede subir: prevention_or_admin | prevention_admin_hr_assets | admin | hr | assets
  uploadBy      String    @default("prevention_or_admin") @map("upload_by")
  /// Quién puede ver (roles admin): mismos códigos que uploadBy.
  viewBy        String    @default("prevention_or_admin") @map("view_by")
  /// Si el tripulante ve el documento en su expediente.
  crewCanView   Boolean   @default(true) @map("crew_can_view")
  /// Legacy: nobody | employee | employee_supervisor | supervisor (sincronizado con crewCanView).
  visibility    String    @default("employee") @map("visibility")
  /**
   * Pack de habilitación editable (Anexo A).
   * company = entra en los 8 de empresa; person = los 8 de persona; null = fuera del pack.
   */
  accreditationPack AccreditationScope? @map("accreditation_pack")
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  documents     CrewMemberDocument[]
  /// Exigencias de tipos de permiso que apuntan a este tipo de documento.
  permitTypeRequirements PermitTypeRequirement[]
  /// Capacitaciones que se acreditan con este tipo de documento.
  trainings              Training[]

  @@index([businessId])
  @@index([code, businessId])
  @@index([subtype])
  @@index([appliesTo])
  @@index([accreditationPack])
  @@map("document_types")
}

/**
 * Rango / cargo marítimo (catálogo por empresa).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model Rank {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("ranks")
}

/**
 * Título académico / marítimo (catálogo por empresa).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model AcademicDegree {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("academic_degrees")
}

/**
 * Certificado de competencia (catálogo por empresa).
 * officerKind opcional (etiqueta capitán / primer piloto).
 * requiresMuelleTravesia: exige asignar muelles y travesías al tripulante.
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model CompetencyCertificate {
  id            String       @id @default(uuid()) @db.Uuid
  legacyMongoId String?      @unique @map("legacy_mongo_id")
  name          String
  businessId    String       @map("business_id") @db.Uuid
  business      Business     @relation(fields: [businessId], references: [id])
  /// Capitán / primer piloto; null = sin clasificar (solo etiqueta).
  officerKind   OfficerKind? @map("officer_kind")
  /// Si true, el modal de embarcado exige ≥1 muelle y ≥1 travesía.
  requiresMuelleTravesia Boolean @default(false) @map("requires_muelle_travesia")
  state         Boolean      @default(true)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]
  /// Cursos vinculados a este título marítimo (obligatorios / opcionales).
  courses       CompetencyCertificateCourse[]

  @@index([businessId])
  @@index([name, businessId])
  @@index([officerKind])
  @@index([requiresMuelleTravesia])
  @@map("competency_certificates")
}

/**
 * Curso del catálogo por empresa (OMI / formación).
 * Único por (name, whereTaught, business) entre no borrados (índice parcial).
 */
model Course {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  /// Lugar de dictado (institución / sede).
  whereTaught   String    @map("where_taught")
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  description   String?
  /// Obligatorio por defecto (portal viejo).
  isMandatory   Boolean   @default(true) @map("is_mandatory")
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// Títulos marítimos que incluyen este curso.
  certificateLinks CompetencyCertificateCourse[]
  /// Asignaciones a tripulantes.
  crewAssignments  CrewMemberCourse[]

  @@index([businessId])
  @@index([name, whereTaught, businessId])
  @@map("courses")
}

/// Lugar de trabajo de una empresa. Soft delete; nombre único por business entre no borradas.
model Location {
  id            String        @id @default(uuid()) @db.Uuid
  legacyMongoId String?       @unique @map("legacy_mongo_id")
  name          String
  /// Nave / oficina / bodega / otro; null = sin clasificar (p. ej. migrado).
  kind          LocationKind?
  businessId    String        @map("business_id") @db.Uuid
  business      Business      @relation(fields: [businessId], references: [id])
  country       String?       @default("Chile")
  commune       String?
  city          String?
  phone         String?
  email         String?
  description   String?
  state         Boolean       @default(true)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]
  areas         Area[]
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@index([kind])
  @@map("locations")
}

/**
 * Área dentro de un lugar de trabajo.
 * locationId obligatorio; businessId desnormalizado (mismo que location.businessId)
 * para filtrar por empresa sin join. El service valida coherencia location↔business.
 * Nombre único por location entre no borradas (índice parcial en migración).
 */
model Area {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  locationId    String    @map("location_id") @db.Uuid
  location      Location  @relation(fields: [locationId], references: [id])
  /// Copia de location.businessId; no se elige aparte en UI.
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]
  crewMembers   CrewMember[]

  @@index([locationId])
  @@index([businessId])
  @@index([name, locationId])
  @@map("areas")
}

/**
 * Tripulante (ficha). Soft delete.
 * RUN y email únicos por empresa entre no borrados (índices parciales en migración).
 * Link 1:1 con User vía userId (User.crewMember es la relación inversa).
 */
model CrewMember {
  id                         String                  @id @default(uuid()) @db.Uuid
  legacyMongoId              String?                 @unique @map("legacy_mongo_id")
  run                        String
  firstName                  String                  @map("first_name")
  lastName                   String                  @map("last_name")
  email                      String
  birthDate                  DateTime?               @map("birth_date") @db.Timestamptz
  nationality                String?
  phone                      String?
  direction                  String?
  observation                String?
  /// Vigencia del libro de embarque (requerida en portal viejo).
  boardingBookValidUntil     DateTime                @map("boarding_book_valid_until") @db.Timestamptz
  businessId                 String                  @map("business_id") @db.Uuid
  business                   Business                @relation(fields: [businessId], references: [id])
  locationId                 String                  @map("location_id") @db.Uuid
  location                   Location                @relation(fields: [locationId], references: [id])
  areaId                     String?                 @map("area_id") @db.Uuid
  area                       Area?                   @relation(fields: [areaId], references: [id])
  rankId                     String?                 @map("rank_id") @db.Uuid
  rank                       Rank?                   @relation(fields: [rankId], references: [id])
  academicDegreeId           String?                 @map("academic_degree_id") @db.Uuid
  academicDegree             AcademicDegree?         @relation(fields: [academicDegreeId], references: [id])
  competencyCertificateId    String?                 @map("competency_certificate_id") @db.Uuid
  competencyCertificate      CompetencyCertificate?  @relation(fields: [competencyCertificateId], references: [id])
  /// Cuenta portal vinculada (opcional, única).
  userId                     String?                 @unique @map("user_id") @db.Uuid
  user                       User?                   @relation(fields: [userId], references: [id])
  state                      Boolean                 @default(true)
  deletedAt                  DateTime?               @map("deleted_at") @db.Timestamptz
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  documents                  CrewMemberDocument[]
  muelleAssignments          CrewMemberMuelle[]
  travesiaAssignments        CrewMemberTravesia[]
  /// Cursos asignados a este tripulante (ficha).
  courseAssignments          CrewMemberCourse[]
  /// Avisos de vencimiento dirigidos a este tripulante.
  notificationOutbox         NotificationOutbox[]

  @@index([businessId])
  @@index([locationId])
  @@index([areaId])
  @@index([rankId])
  @@index([academicDegreeId])
  @@index([competencyCertificateId])
  @@index([run, businessId])
  @@index([email, businessId])
  @@map("crew_members")
}

/**
 * Curso vinculado a un título marítimo (catálogo N:M).
 * isMandatory del join gana sobre el del Course al auto-asignar (S8).
 * Único por par entre no borrados (índice parcial en migración).
 */
model CompetencyCertificateCourse {
  id                       String                @id @default(uuid()) @db.Uuid
  legacyMongoId            String?               @unique @map("legacy_mongo_id")
  competencyCertificateId  String                @map("competency_certificate_id") @db.Uuid
  competencyCertificate    CompetencyCertificate @relation(fields: [competencyCertificateId], references: [id])
  courseId                 String                @map("course_id") @db.Uuid
  course                   Course                @relation(fields: [courseId], references: [id])
  /// Si true, al asignar título al tripulante el curso se crea como obligatorio.
  isMandatory              Boolean               @default(true) @map("is_mandatory")
  deletedAt                DateTime?             @map("deleted_at") @db.Timestamptz
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@index([competencyCertificateId])
  @@index([courseId])
  @@map("competency_certificate_courses")
}

/**
 * Asignación de un curso del catálogo a un tripulante.
 * Única por (crewMember, course) entre no borradas (índice parcial en migración).
 * Campos de mail listos para el job de S9; status se recalcula en API.
 */
model CrewMemberCourse {
  id                     String           @id @default(uuid()) @db.Uuid
  legacyMongoId          String?          @unique @map("legacy_mongo_id")
  crewMemberId           String           @map("crew_member_id") @db.Uuid
  crewMember             CrewMember       @relation(fields: [crewMemberId], references: [id])
  courseId               String           @map("course_id") @db.Uuid
  course                 Course           @relation(fields: [courseId], references: [id])
  /// Fecha en que completó / aprobó el curso; null = aún pendiente.
  completedAt            DateTime?        @map("completed_at") @db.Timestamptz
  /// Vencimiento del curso; null = sin caducidad conocida.
  expiresAt              DateTime?        @map("expires_at") @db.Timestamptz
  /// Estado persistido; la API lo recalcula al leer/escribir.
  status                 CrewCourseStatus @default(pending)
  /// De dónde salió la fila (auto por título vs alta manual).
  source                 CrewCourseSource @default(manual)
  /// Último mail de “por vencer” enviado (S9).
  lastExpiringEmailAt    DateTime?        @map("last_expiring_email_at") @db.Timestamptz
  /// Último mail de “vencido” enviado (S9).
  lastExpiredEmailAt     DateTime?        @map("last_expired_email_at") @db.Timestamptz
  /// Días-antes ya notificados (hitos del job; portal viejo).
  expiringMilestonesSent Int[]            @default([]) @map("expiring_milestones_sent")
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([courseId])
  @@index([expiresAt])
  @@index([status])
  @@map("crew_member_courses")
}

/**
 * Asignación N:M tripulante ↔ muelle.
 * Única por par entre no borradas (índice parcial en migración).
 */
model CrewMemberMuelle {
  id            String     @id @default(uuid()) @db.Uuid
  legacyMongoId String?    @unique @map("legacy_mongo_id")
  crewMemberId  String     @map("crew_member_id") @db.Uuid
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id])
  muelleId      String     @map("muelle_id") @db.Uuid
  muelle        Muelle     @relation(fields: [muelleId], references: [id])
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([muelleId])
  @@map("crew_member_muelles")
}

/**
 * Asignación N:M tripulante ↔ travesía.
 * Única por par entre no borradas (índice parcial en migración).
 */
model CrewMemberTravesia {
  id            String     @id @default(uuid()) @db.Uuid
  legacyMongoId String?    @unique @map("legacy_mongo_id")
  crewMemberId  String     @map("crew_member_id") @db.Uuid
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id])
  travesiaId    String     @map("travesia_id") @db.Uuid
  travesia      Travesia   @relation(fields: [travesiaId], references: [id])
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([travesiaId])
  @@map("crew_member_travesias")
}

/**
 * Documento de tripulante (archivo en disco local).
 * Tipo vía DocumentType; sourceModule indica quién lo cargó.
 */
model CrewMemberDocument {
  id             String       @id @default(uuid()) @db.Uuid
  legacyMongoId  String?      @unique @map("legacy_mongo_id")
  crewMemberId   String       @map("crew_member_id") @db.Uuid
  crewMember     CrewMember   @relation(fields: [crewMemberId], references: [id])
  documentTypeId String       @map("document_type_id") @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  originalName   String       @map("original_name")
  mimeType       String       @map("mime_type")
  size           Int
  /// Relativa: /uploads/{businessId}/crew-members/{crewId}/…
  filePath       String       @map("file_path")
  /// crew | prevention | assets | system
  sourceModule   String       @default("crew") @map("source_module")
  uploadedById   String?      @map("uploaded_by_id") @db.Uuid
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([documentTypeId])
  @@index([sourceModule])
  @@map("crew_member_documents")
}

/// Challenge MFA de login: código de 6 dígitos por correo (hash en BD).
model LoginChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  /// UUID público que recibe el cliente (verify / resend).
  challengeId String   @unique @map("challenge_id")
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  /// SHA-256 hex del código en claro.
  codeHash    String   @map("code_hash")
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Tokens de un solo uso enviados por correo (hash en BD; plain solo en el mail).
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  purpose   EmailTokenPurpose
  /// SHA-256 hex del token en claro.
  tokenHash String            @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([tokenHash])
  @@index([userId, purpose])
  @@map("email_tokens")
}

/**
 * Estado global del sistema (key/value JSON).
 * Portal viejo SystemState: settings de avisos, cursor de digests admin, etc.
 */
model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  /// Clave estable (ej. expiry_notification_settings).
  key       String   @unique
  /// Valor libre (JSON); el service valida por key.
  value     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

/**
 * Cola de correos de vencimiento (outbox).
 * El generador inserta; el worker envía con Resend (override a correo de prueba mientras el portal viejo esté vivo).
 */
model NotificationOutbox {
  id            String                    @id @default(uuid()) @db.Uuid
  legacyMongoId String?                   @unique @map("legacy_mongo_id")
  type          NotificationOutboxType
  /// Idempotencia: un solo aviso por clave (tipo + entidad + hito + destinatario).
  dedupeKey     String                    @unique @map("dedupe_key")
  /// Destinatario lógico (tripulante/admin). El worker puede reescribirlo con NOTIFICATION_EMAIL_OVERRIDE.
  to            String
  /// Datos del mail (nombre, curso, fechas, etc.).
  payload       Json?
  status        NotificationOutboxStatus  @default(pending)
  attempts      Int                       @default(0)
  /// Tope de reintentos antes de quedar en failed (portal viejo: 8).
  maxAttempts   Int                       @default(8) @map("max_attempts")
  nextAttemptAt DateTime                  @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?                   @map("last_error")
  lockedAt      DateTime?                 @map("locked_at") @db.Timestamptz
  sentAt        DateTime?                 @map("sent_at") @db.Timestamptz
  businessId    String?                   @map("business_id") @db.Uuid
  business      Business?                 @relation(fields: [businessId], references: [id])
  crewMemberId  String?                   @map("crew_member_id") @db.Uuid
  crewMember    CrewMember?               @relation(fields: [crewMemberId], references: [id])
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([crewMemberId, status])
  @@index([businessId, status, createdAt])
  @@map("notification_outbox")
}

/**
 * Registro de actividad (auditoría).
 * Se escribe en fire-and-forget desde controllers; listado solo superadmin.
 */
model ActivityLog {
  id             String           @id @default(uuid()) @db.Uuid
  legacyMongoId  String?          @unique @map("legacy_mongo_id")
  action         ActivityAction
  resource       ActivityResource
  /// Id del recurso tocado (uuid u otro); null en LOGIN/LOGOUT sin target.
  resourceId     String?          @map("resource_id")
  actorId        String?          @map("actor_id") @db.Uuid
  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot del actor al momento del evento (sigue legible si borran el user).
  actorUsername  String?          @map("actor_username")
  actorEmail     String?          @map("actor_email")
  actorRole      String?          @map("actor_role")
  /// Etiqueta humana del target (ej. email, nombre de empresa).
  targetLabel    String?          @map("target_label")
  success        Boolean          @default(true)
  errorMessage   String?          @map("error_message")
  ip             String?
  userAgent      String?          @map("user_agent")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, action, createdAt])
  @@map("activity_logs")
}

/**
 * Aviso de sistema (campanita del topbar).
 * Portal viejo SystemAnnouncement: version / maintenance / config.
 */
model SystemAnnouncement {
  id            String                 @id @default(uuid()) @db.Uuid
  legacyMongoId String?                @unique @map("legacy_mongo_id")
  /// Idempotencia de avisos de versión (ej. version:2.0.0).
  dedupeKey     String?                @unique @map("dedupe_key")
  kind          SystemAnnouncementKind
  title         String
  body          String
  metadata      Json?
  publishedAt   DateTime               @default(now()) @map("published_at") @db.Timestamptz
  expiresAt     DateTime?              @map("expires_at") @db.Timestamptz
  createdById   String?                @map("created_by_id") @db.Uuid
  createdBy     User?                  @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt     DateTime?              @map("deleted_at") @db.Timestamptz
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  reads         UserAnnouncementRead[]

  @@index([deletedAt, publishedAt])
  @@map("system_announcements")
}

/**
 * Lectura de un aviso por usuario (reemplaza seenSystemAnnouncementIds del portal viejo).
 */
model UserAnnouncementRead {
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String             @map("announcement_id") @db.Uuid
  announcement   SystemAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime           @default(now()) @map("read_at") @db.Timestamptz

  @@id([userId, announcementId])
  @@index([userId])
  @@map("user_announcement_reads")
}

/**
 * Tipo de permiso de trabajo (P1 · P14).
 * Maestro por empresa: ALT, CAL, ECF, GEN, BUC (+ tipos nuevos).
 * Flujo/checklist ítems se agregan en pasos siguientes.
 */
model PermitType {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  business    Business          @relation(fields: [businessId], references: [id])
  /// Código corto estable (ALT, CAL, ECF, GEN, BUC).
  code        String
  name        String
  criticality PermitCriticality
  /// Si true, el tipo exige AST (formulario y/o PDF según astMode).
  requiresAst Boolean           @default(false) @map("requires_ast")
  /// Null si requiresAst=false.
  astMode     PermitAstMode?    @map("ast_mode")
  description String?
  /// false = desactivado (Figma «Desactivar tipo»); no borra historial.
  active      Boolean           @default(true)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  /// Exigencias del tipo (documentos, capacitaciones, checklist).
  requirements PermitTypeRequirement[]
  /// Ítems del checklist propio del tipo (P15 · Checklist N ítems).
  checklistItems PermitChecklistItem[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([active])
  @@map("permit_types")
}

/**
 * Exigencia de un tipo de permiso (P1 · P15 Exigencias).
 * Seed de ejemplo: 8 filas de CAL (spec Anexo).
 * trainingCode hasta existir tabla trainings (P1 capacitaciones).
 */
model PermitTypeRequirement {
  id                   String                   @id @default(uuid()) @db.Uuid
  permitTypeId         String                   @map("permit_type_id") @db.Uuid
  permitType           PermitType               @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  /// Clave estable por tipo (seed idempotente), ej. cal.docs_company_pack.
  key                  String
  kind                 PermitRequirementKind
  scope                PermitRequirementScope
  moment               PermitRequirementMoment  @default(before)
  mandatory            Boolean                  @default(true)
  /// kind=document y apunta a un tipo concreto (PS, PP…).
  documentTypeId       String?                  @map("document_type_id") @db.Uuid
  documentType         DocumentType?            @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  /// kind=document pack «los 8» (empresa o persona).
  accreditationScope   AccreditationScope?      @map("accreditation_scope")
  /// kind=training: código de catálogo (EXT-01); redundante con trainingId para lectura.
  trainingCode         String?                  @map("training_code")
  /// FK a Training cuando el catálogo ya existe en la empresa.
  trainingId           String?                  @map("training_id") @db.Uuid
  training             Training?                @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  /// Texto visible en la tabla (Figma columna Exigencia).
  label                String
  active               Boolean                  @default(true)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([permitTypeId, key])
  @@index([permitTypeId])
  @@index([kind])
  @@index([trainingId])
  @@map("permit_type_requirements")
}

/**
 * Capacitación del módulo Prevención (P1 · P4).
 * Distinta de Course (OMI/tripulación). Código estable por empresa (EXT-01…).
 */
model Training {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  business       Business  @relation(fields: [businessId], references: [id])
  /// Código corto (ALT-01, EXT-01, ODI-01, IND-SEG…).
  code           String
  name           String
  /// Meses de vigencia; null = sin vencimiento.
  validityMonths Int?      @map("validity_months")
  /**
   * A quién aplica (tags). Valores: crew | external_person.
   * Array Prisma para poder marcar ambos.
   */
  appliesTo      String[]  @default([]) @map("applies_to")
  /// Documento que acredita la capacitación (opcional si el tipo aún no existe).
  documentTypeId String?   @map("document_type_id") @db.Uuid
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  active         Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  /// Exigencias de permiso que apuntan a esta capacitación.
  permitTypeRequirements PermitTypeRequirement[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([active])
  @@map("trainings")
}

/**
 * Ítem del checklist de un tipo de permiso (P1).
 * Orden estable; el requisito kind=checklist apunta al set completo.
 */
model PermitChecklistItem {
  id           String     @id @default(uuid()) @db.Uuid
  permitTypeId String     @map("permit_type_id") @db.Uuid
  permitType   PermitType @relation(fields: [permitTypeId], references: [id], onDelete: Cascade)
  /// Posición 1-based en la UI / PDF del permiso.
  order        Int
  text         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([permitTypeId, order])
  @@index([permitTypeId])
  @@map("permit_checklist_items")
}
