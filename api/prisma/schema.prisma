// Convenciones: IDs uuid; deletedAt en User y Role; tablas snake_case plural con @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleDataScope {
  all
  business
  location
  area
  self
}

/// Propósito del token de correo (confirmación de cuenta o reset de clave).
enum EmailTokenPurpose {
  confirm_email
  reset_password
}

/// Tipo de lugar de trabajo. Nullable: ETL deja null; se clasifica después en Wave.
/// UI: vessel=Nave, office=Oficina, warehouse=Bodega, other=Otro.
enum LocationKind {
  vessel
  office
  warehouse
  other
}

/// Oficial de nave asociado a un certificado de competencia (portal viejo).
/// UI: captain=Capitán, first_pilot=Primer piloto. Null = sin clasificar.
enum OfficerKind {
  captain
  first_pilot
}

/**
 * Puerto del catálogo por empresa (maestro de muelles).
 * Nombre único por business entre no borrados (índice parcial en migración).
 */
model Port {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  /// Nombre del puerto; casing se conserva (ej. "Puerto Montt").
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  muelles       Muelle[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("ports")
}

/**
 * Muelle por puerto y empresa.
 * Único por (portId, name, business) entre no borrados (índice parcial).
 * El service valida que port.businessId === muelle.businessId.
 */
model Muelle {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  portId        String    @map("port_id") @db.Uuid
  port          Port      @relation(fields: [portId], references: [id])
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewAssignments CrewMemberMuelle[]

  @@index([businessId])
  @@index([portId])
  @@index([name, portId, businessId])
  @@map("muelles")
}

/**
 * Travesía del catálogo por empresa (cuota de pasadas para oficiales).
 * requiredPassages solo 10 o 4 (validado en Zod; Int en PG).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model Travesia {
  id               String    @id @default(uuid()) @db.Uuid
  legacyMongoId    String?   @unique @map("legacy_mongo_id")
  name             String
  /// Cuota de pasadas requeridas (10 o 4 en el portal viejo).
  requiredPassages Int       @map("required_passages")
  businessId       String    @map("business_id") @db.Uuid
  business         Business  @relation(fields: [businessId], references: [id])
  state            Boolean   @default(true)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewAssignments  CrewMemberTravesia[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("travesias")
}

model Role {
  id            String        @id @default(uuid()) @db.Uuid
  legacyMongoId String?       @unique @map("legacy_mongo_id")
  key           String
  name          String
  description   String        @default("")
  isSystem      Boolean       @default(false) @map("is_system")
  dataScope     RoleDataScope @map("data_scope")
  /// [{ resource, actions: string[] }] — mismo shape que el portal viejo.
  permissions   Json          @default("[]")
  state         Boolean       @default(true)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]

  @@unique([key])
  @@map("roles")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  legacyMongoId   String?          @unique @map("legacy_mongo_id")
  run             String
  username        String
  passwordHash    String           @map("password_hash")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  email           String
  pendingEmail    String?          @map("pending_email")
  /// Ruta relativa de foto (/uploads/…), como photoProfile del portal viejo.
  photoProfile    String?          @map("photo_profile")
  internalRol     String           @default("user") @map("internal_rol")
  roleId          String?          @map("role_id") @db.Uuid
  role            Role?            @relation(fields: [roleId], references: [id])
  state           Boolean          @default(true)
  confirmed       Boolean          @default(false)
  // Tenant: business (S2), location (S3); area cuando exista (S4).
  businessId      String?          @map("business_id") @db.Uuid
  business        Business?        @relation(fields: [businessId], references: [id])
  locationId      String?          @map("location_id") @db.Uuid
  location        Location?        @relation(fields: [locationId], references: [id])
  areaId          String?          @map("area_id") @db.Uuid
  area            Area?            @relation(fields: [areaId], references: [id])
  tokenVersion    Int              @default(0) @map("token_version")
  lastLoginAt     DateTime?        @map("last_login_at") @db.Timestamptz
  lastLoginIp     String?          @map("last_login_ip")
  loginAttempts   Int              @default(0) @map("login_attempts")
  lockUntil       DateTime?        @map("lock_until") @db.Timestamptz
  /// Acceso con vencimiento (útiles para externos / invitados temporales).
  accessExpiresAt DateTime?        @map("access_expires_at") @db.Timestamptz
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  emailTokens     EmailToken[]
  loginChallenges LoginChallenge[]
  /// Refresh rotativos (hash); permite revocar uno sin invalidar todos.
  refreshTokens   RefreshToken[]
  /// Tripulante vinculado (FK en crew_members.user_id; 1:1).
  crewMember      CrewMember?
  /// Documentos de tripulante subidos por este usuario.
  uploadedCrewDocuments CrewMemberDocument[]

  @@index([email])
  @@index([username])
  @@index([businessId])
  @@index([locationId])
  @@index([areaId])
  @@map("users")
}

/// Refresh JWT rotativo: solo se guarda el hash SHA-256 (revocable).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex del JWT de refresh (nunca el token en claro).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("refresh_tokens")
}

/// Empresa (tenant). Soft delete; nombre único entre no borradas (índice parcial en migración).
model Business {
  id                     String                  @id @default(uuid()) @db.Uuid
  legacyMongoId          String?                 @unique @map("legacy_mongo_id")
  rut                    String?
  name                   String
  giro                   String?
  country                String?                 @default("Chile")
  commune                String?
  city                   String?
  phone                  String?
  email                  String?
  description            String?
  state                  Boolean                 @default(true)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  users                  User[]
  locations              Location[]
  areas                  Area[]
  ranks                  Rank[]
  academicDegrees        AcademicDegree[]
  competencyCertificates CompetencyCertificate[]
  courses                Course[]
  ports                  Port[]
  muelles                Muelle[]
  travesias              Travesia[]
  crewMembers            CrewMember[]
  documentTypes          DocumentType[]

  @@index([name])
  @@map("businesses")
}

/**
 * Tipo de documento del expediente (maestro por empresa).
 * Códigos alineados al sistema HR (CO, EN, VI, TI…).
 * Unique (code, business) entre no borrados: índice parcial en migración.
 */
model DocumentType {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  /// Código corto estable (ej. CO, EN, VI) — 2 a 4 letras.
  code          String
  name          String
  /// general | finiquito | requerimiento | prevencion | maritimo | activo
  subtype       String    @default("general")
  /// crew | external | crew_and_external (Figma «Aplica a»).
  appliesTo     String    @default("crew_and_external") @map("applies_to")
  /// Si true, al cargar pide fecha de vencimiento (Figma «Vence»).
  requiresExpiry Boolean  @default(false) @map("requires_expiry")
  /// Quién puede subir: prevention_or_admin | prevention_admin_hr_assets | admin | hr | assets
  uploadBy      String    @default("prevention_or_admin") @map("upload_by")
  /// Quién puede ver (roles admin): mismos códigos que uploadBy.
  viewBy        String    @default("prevention_or_admin") @map("view_by")
  /// Si el tripulante ve el documento en su expediente.
  crewCanView   Boolean   @default(true) @map("crew_can_view")
  /// Legacy: nobody | employee | employee_supervisor | supervisor (sincronizado con crewCanView).
  visibility    String    @default("employee") @map("visibility")
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  documents     CrewMemberDocument[]

  @@index([businessId])
  @@index([code, businessId])
  @@index([subtype])
  @@index([appliesTo])
  @@map("document_types")
}

/**
 * Rango / cargo marítimo (catálogo por empresa).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model Rank {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("ranks")
}

/**
 * Título académico / marítimo (catálogo por empresa).
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model AcademicDegree {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@map("academic_degrees")
}

/**
 * Certificado de competencia (catálogo por empresa).
 * officerKind opcional (etiqueta capitán / primer piloto).
 * requiresMuelleTravesia: exige asignar muelles y travesías al tripulante.
 * Nombre único por business entre no borradas (índice parcial en migración).
 */
model CompetencyCertificate {
  id            String       @id @default(uuid()) @db.Uuid
  legacyMongoId String?      @unique @map("legacy_mongo_id")
  name          String
  businessId    String       @map("business_id") @db.Uuid
  business      Business     @relation(fields: [businessId], references: [id])
  /// Capitán / primer piloto; null = sin clasificar (solo etiqueta).
  officerKind   OfficerKind? @map("officer_kind")
  /// Si true, el modal de embarcado exige ≥1 muelle y ≥1 travesía.
  requiresMuelleTravesia Boolean @default(false) @map("requires_muelle_travesia")
  state         Boolean      @default(true)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@index([officerKind])
  @@index([requiresMuelleTravesia])
  @@map("competency_certificates")
}

/**
 * Curso del catálogo por empresa (OMI / formación).
 * Único por (name, whereTaught, business) entre no borrados (índice parcial).
 */
model Course {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  /// Lugar de dictado (institución / sede).
  whereTaught   String    @map("where_taught")
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  description   String?
  /// Obligatorio por defecto (portal viejo).
  isMandatory   Boolean   @default(true) @map("is_mandatory")
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([businessId])
  @@index([name, whereTaught, businessId])
  @@map("courses")
}

/// Lugar de trabajo de una empresa. Soft delete; nombre único por business entre no borradas.
model Location {
  id            String        @id @default(uuid()) @db.Uuid
  legacyMongoId String?       @unique @map("legacy_mongo_id")
  name          String
  /// Nave / oficina / bodega / otro; null = sin clasificar (p. ej. migrado).
  kind          LocationKind?
  businessId    String        @map("business_id") @db.Uuid
  business      Business      @relation(fields: [businessId], references: [id])
  country       String?       @default("Chile")
  commune       String?
  city          String?
  phone         String?
  email         String?
  description   String?
  state         Boolean       @default(true)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]
  areas         Area[]
  crewMembers   CrewMember[]

  @@index([businessId])
  @@index([name, businessId])
  @@index([kind])
  @@map("locations")
}

/**
 * Área dentro de un lugar de trabajo.
 * locationId obligatorio; businessId desnormalizado (mismo que location.businessId)
 * para filtrar por empresa sin join. El service valida coherencia location↔business.
 * Nombre único por location entre no borradas (índice parcial en migración).
 */
model Area {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id")
  name          String
  locationId    String    @map("location_id") @db.Uuid
  location      Location  @relation(fields: [locationId], references: [id])
  /// Copia de location.businessId; no se elige aparte en UI.
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  state         Boolean   @default(true)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  users         User[]
  crewMembers   CrewMember[]

  @@index([locationId])
  @@index([businessId])
  @@index([name, locationId])
  @@map("areas")
}

/**
 * Tripulante (ficha). Soft delete.
 * RUN y email únicos por empresa entre no borrados (índices parciales en migración).
 * Link 1:1 con User vía userId (User.crewMember es la relación inversa).
 */
model CrewMember {
  id                         String                  @id @default(uuid()) @db.Uuid
  legacyMongoId              String?                 @unique @map("legacy_mongo_id")
  run                        String
  firstName                  String                  @map("first_name")
  lastName                   String                  @map("last_name")
  email                      String
  birthDate                  DateTime?               @map("birth_date") @db.Timestamptz
  nationality                String?
  phone                      String?
  direction                  String?
  observation                String?
  /// Vigencia del libro de embarque (requerida en portal viejo).
  boardingBookValidUntil     DateTime                @map("boarding_book_valid_until") @db.Timestamptz
  businessId                 String                  @map("business_id") @db.Uuid
  business                   Business                @relation(fields: [businessId], references: [id])
  locationId                 String                  @map("location_id") @db.Uuid
  location                   Location                @relation(fields: [locationId], references: [id])
  areaId                     String?                 @map("area_id") @db.Uuid
  area                       Area?                   @relation(fields: [areaId], references: [id])
  rankId                     String?                 @map("rank_id") @db.Uuid
  rank                       Rank?                   @relation(fields: [rankId], references: [id])
  academicDegreeId           String?                 @map("academic_degree_id") @db.Uuid
  academicDegree             AcademicDegree?         @relation(fields: [academicDegreeId], references: [id])
  competencyCertificateId    String?                 @map("competency_certificate_id") @db.Uuid
  competencyCertificate      CompetencyCertificate?  @relation(fields: [competencyCertificateId], references: [id])
  /// Cuenta portal vinculada (opcional, única).
  userId                     String?                 @unique @map("user_id") @db.Uuid
  user                       User?                   @relation(fields: [userId], references: [id])
  state                      Boolean                 @default(true)
  deletedAt                  DateTime?               @map("deleted_at") @db.Timestamptz
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  documents                  CrewMemberDocument[]
  muelleAssignments          CrewMemberMuelle[]
  travesiaAssignments        CrewMemberTravesia[]

  @@index([businessId])
  @@index([locationId])
  @@index([areaId])
  @@index([rankId])
  @@index([academicDegreeId])
  @@index([competencyCertificateId])
  @@index([run, businessId])
  @@index([email, businessId])
  @@map("crew_members")
}

/**
 * Asignación N:M tripulante ↔ muelle.
 * Única por par entre no borradas (índice parcial en migración).
 */
model CrewMemberMuelle {
  id            String     @id @default(uuid()) @db.Uuid
  legacyMongoId String?    @unique @map("legacy_mongo_id")
  crewMemberId  String     @map("crew_member_id") @db.Uuid
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id])
  muelleId      String     @map("muelle_id") @db.Uuid
  muelle        Muelle     @relation(fields: [muelleId], references: [id])
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([muelleId])
  @@map("crew_member_muelles")
}

/**
 * Asignación N:M tripulante ↔ travesía.
 * Única por par entre no borradas (índice parcial en migración).
 */
model CrewMemberTravesia {
  id            String     @id @default(uuid()) @db.Uuid
  legacyMongoId String?    @unique @map("legacy_mongo_id")
  crewMemberId  String     @map("crew_member_id") @db.Uuid
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id])
  travesiaId    String     @map("travesia_id") @db.Uuid
  travesia      Travesia   @relation(fields: [travesiaId], references: [id])
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([travesiaId])
  @@map("crew_member_travesias")
}

/**
 * Documento de tripulante (archivo en disco local).
 * Tipo vía DocumentType; sourceModule indica quién lo cargó.
 */
model CrewMemberDocument {
  id             String       @id @default(uuid()) @db.Uuid
  legacyMongoId  String?      @unique @map("legacy_mongo_id")
  crewMemberId   String       @map("crew_member_id") @db.Uuid
  crewMember     CrewMember   @relation(fields: [crewMemberId], references: [id])
  documentTypeId String       @map("document_type_id") @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  originalName   String       @map("original_name")
  mimeType       String       @map("mime_type")
  size           Int
  /// Relativa: /uploads/{businessId}/crew-members/{crewId}/…
  filePath       String       @map("file_path")
  /// crew | prevention | assets | system
  sourceModule   String       @default("crew") @map("source_module")
  uploadedById   String?      @map("uploaded_by_id") @db.Uuid
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([crewMemberId])
  @@index([documentTypeId])
  @@index([sourceModule])
  @@map("crew_member_documents")
}

/// Challenge MFA de login: código de 6 dígitos por correo (hash en BD).
model LoginChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  /// UUID público que recibe el cliente (verify / resend).
  challengeId String   @unique @map("challenge_id")
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  /// SHA-256 hex del código en claro.
  codeHash    String   @map("code_hash")
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Tokens de un solo uso enviados por correo (hash en BD; plain solo en el mail).
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  purpose   EmailTokenPurpose
  /// SHA-256 hex del token en claro.
  tokenHash String            @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([tokenHash])
  @@index([userId, purpose])
  @@map("email_tokens")
}
