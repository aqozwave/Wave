PORT=3000
# Detrás de Vite/nginx: 1 (un hop). Vacío = no confiar X-Forwarded-For.
TRUST_PROXY=1
DATABASE_URL="postgresql://wave:wave@localhost:5432/wave?schema=public"

# JWT (cambiar en cada entorno; no commitear valores reales)
JWT_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bloqueo por intentos fallidos de login (par IP+email en memoria)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Cookie refresh: Secure en production por defecto; forzá con true/false
COOKIE_SECURE=
# SameSite: Lax (default) | Strict | None (None implica Secure)
COOKIE_SAMESITE=Lax

# Swagger / OpenAPI: off en production salvo true; on en local salvo false
ENABLE_API_DOCS=

# Correo (Resend). Sin RESEND_API_KEY el envío queda en stub (token en log).
RESEND_API_KEY=
# Con dominio verificado en Resend: noreply@tu-dominio.com
# Sin dominio (sandbox): onboarding@resend.dev solo llega a tu cuenta Resend
EMAIL_FROM="Portal Nachipa Wellboats <noreply@nachipa-w.com>"
WEB_APP_URL="http://localhost:5173"
EMAIL_CONFIRM_EXPIRES_MINUTES=1440
EMAIL_RESET_EXPIRES_MINUTES=60

# MFA de login (código por correo). false|0 lo desactiva (Bruno simple).
LOGIN_MFA_ENABLED=true
LOGIN_MFA_CODE_EXPIRES_MINUTES=10
LOGIN_MFA_MAX_ATTEMPTS=5

# Notificaciones de vencimiento (S9). Mientras el portal viejo envíe a gente real:
# - jobs deshabilitados por defecto
# - todo mail de outbox se reescribe a NOTIFICATION_EMAIL_OVERRIDE (prueba)
NOTIFICATION_OUTBOX_JOB_ENABLED=false
NOTIFICATION_COURSE_EXPIRY_JOB_ENABLED=false
NOTIFICATION_OUTBOX_JOB_INTERVAL_MS=300000
NOTIFICATION_OUTBOX_JOB_INITIAL_DELAY_MS=20000
# Disparo diario del generador (America/Santiago 08:00 por defecto)
COURSE_EXPIRY_JOB_TIMEZONE=America/Santiago
COURSE_EXPIRY_JOB_HOUR=8
COURSE_EXPIRY_JOB_MINUTE=0
# false = no correr al arrancar; solo a la hora programada
COURSE_EXPIRY_JOB_RUN_ON_STARTUP=false
NOTIFICATION_EMAIL_OVERRIDE=fsoto@nachipa-w.com

# ETL Mongo → Postgres (solo lectura en Mongo). No commitear URI real.
# Para datos reales de prod: MONGO_DB_NAME=nachipa-prod
# Otras: core-api (dev) | nachipa-prod-test (staging)
MONGO_URI=
MONGO_DB_NAME=nachipa-prod
