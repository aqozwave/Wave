PORT=3000
DATABASE_URL="postgresql://wave:wave@localhost:5432/wave?schema=public"

# JWT (cambiar en cada entorno; no commitear valores reales)
JWT_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Bloqueo por intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Correo (Resend). Sin RESEND_API_KEY el envío queda en stub (token en log).
RESEND_API_KEY=
# Con dominio verificado en Resend: noreply@tu-dominio.com
# Sin dominio (sandbox): onboarding@resend.dev solo llega a tu cuenta Resend
EMAIL_FROM="Portal Nachipa Wellboats <noreply@nachipa-w.com>"
WEB_APP_URL="http://localhost:5173"
EMAIL_CONFIRM_EXPIRES_MINUTES=1440
EMAIL_RESET_EXPIRES_MINUTES=60

# MFA de login (código por correo). false|0 lo desactiva (Bruno simple).
LOGIN_MFA_ENABLED=true
LOGIN_MFA_CODE_EXPIRES_MINUTES=10
LOGIN_MFA_MAX_ATTEMPTS=5
