{
  "name": "wave",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web & wait",
    "dev:web": "npm run dev -w @wave/web",
    "dev:api": "npm run dev -w @wave/api",
    "typecheck": "npm run typecheck -w @wave/api && npm run typecheck -w @wave/web",
    "build:web": "npm run build -w @wave/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:studio": "npm run db:studio -w @wave/api",
    "db:migrate": "npm run db:migrate -w @wave/api",
    "etl:business": "npm run etl:business -w @wave/api --",
    "etl:location": "npm run etl:location -w @wave/api --",
    "etl:area": "npm run etl:area -w @wave/api --",
    "etl:rank": "npm run etl:rank -w @wave/api --",
    "etl:academic-degree": "npm run etl:academic-degree -w @wave/api --",
    "etl:competency-certificate": "npm run etl:competency-certificate -w @wave/api --",
    "etl:course": "npm run etl:course -w @wave/api --",
    "etl:muelle": "npm run etl:muelle -w @wave/api --",
    "etl:travesia": "npm run etl:travesia -w @wave/api --",
    "etl:role": "npm run etl:role -w @wave/api --"
  }
}
